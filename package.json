{
  "name": "seth-oracle-desktop",
  "version": "0.1.0",
  "description": "賽特神諭 Windows 專屬 APP 實驗版",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "tw.sethoracle.desktop",
    "productName": "賽特神諭",
    "directories": {"output":"dist"},
    "files": ["main.js","package.json"],
    "win": {"target":"nsis"},
    "nsis": {"oneClick":false,"allowToChangeInstallationDirectory":true}
  }
}
